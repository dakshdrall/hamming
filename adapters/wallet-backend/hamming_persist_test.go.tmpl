package indexer

// Hamming reference adapter (prototype): ProcessLedger + in-process emulation of the persistence
// encoding step (every driver.Valuer field of every buffered state change is encoded, as the DB COPY would).
// Run: HAMMING_LEDGER=/path/file.xdr go test ./internal/indexer -run TestHammingPersist -v

import (
	"context"
	"database/sql/driver"
	"encoding/binary"
	"encoding/json"
	"fmt"
	"os"
	"reflect"
	"runtime"
	"testing"

	"github.com/alitto/pond/v2"
	"github.com/stellar/go-stellar-sdk/xdr"
)

func TestHammingPersist(t *testing.T) {
	path := os.Getenv("HAMMING_LEDGER")
	if path == "" {
		t.Skip("HAMMING_LEDGER not set")
	}
	const pass = "(V) (;,,;) (V)"
	b, err := os.ReadFile(path)
	if err != nil {
		t.Fatal(err)
	}
	type outT struct {
		Ledgers, StateChanges int
		IndexErrors           []string
		PersistErrors         []string
		SignerValues          []string
		Verdict               string
	}
	out := outT{}
	for i := 0; i < len(b); {
		n := int(binary.BigEndian.Uint32(b[i:]) & 0x7fffffff)
		i += 4
		var lcm xdr.LedgerCloseMeta
		if err := xdr.SafeUnmarshal(b[i:i+n], &lcm); err != nil {
			t.Fatal(err)
		}
		i += n
		out.Ledgers++
		idx, err := NEWINDEXER
		if err != nil {
			t.Fatal(err)
		}
		buf := NewIndexerBuffer()
		if _, err := ProcessLedger(context.Background(), pass, lcm, idx, buf); err != nil {
			out.IndexErrors = append(out.IndexErrors, err.Error())
			continue
		}
		valuer := reflect.TypeOf((*driver.Valuer)(nil)).Elem()
		for _, sc := range buf.GetStateChanges() {
			out.StateChanges++
			v := reflect.ValueOf(sc)
			for f := 0; f < v.NumField(); f++ {
				fv := v.Field(f)
				name := v.Type().Field(f).Name
				if !fv.Type().Implements(valuer) {
					continue
				}
				val, err := fv.Interface().(driver.Valuer).Value()
				if name == "SignerAccountID" && fmt.Sprint(fv.Interface()) != "" {
					out.SignerValues = append(out.SignerValues, fmt.Sprintf("%v", fv.Interface()))
				}
				if err != nil {
					out.PersistErrors = append(out.PersistErrors, fmt.Sprintf("%s: %v", name, err))
				}
				_ = val
			}
		}
	}
	switch {
	case len(out.IndexErrors) > 0:
		out.Verdict = "mishandled (indexer error)"
	case len(out.PersistErrors) > 0:
		out.Verdict = "mishandled (ledger cannot be persisted)"
	default:
		out.Verdict = "pass"
	}
	j, _ := json.MarshalIndent(out, "", " ")
	fmt.Println(string(j))
}
