{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Stellar XDR shape corpus manifest (draft 0.1.0)",
  "type": "object",
  "required": ["schema_version", "network_passphrase", "entries"],
  "properties": {
    "schema": { "type": "string" },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "network_passphrase": { "type": "string" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "level", "xdr_type", "file", "encoding", "sha256", "caps", "protocol_min", "source", "synthetic", "atoms", "expected"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^(str|val|rel)\\.[a-z0-9-]+\\.[a-z0-9-]+\\.\\d{4}$",
                "description": "level.family.pattern.serial; stable forever, never reused" },
        "title": { "type": "string" },
        "level": { "enum": ["structural", "value", "relational"],
                   "description": "structural = a grammar atom (union arm, optional, length class); value = a boundary value inside a valid shape; relational = a property across two or more fields (ordering, collision, envelope-vs-meta)" },
        "xdr_type": { "type": "string", "description": "Root XDR type to decode the file as, e.g. LedgerCloseMeta, TransactionEnvelope, SCVal" },
        "file": { "type": "string" },
        "encoding": { "enum": ["base64", "raw"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Hash of the raw XDR bytes" },
        "bytes": { "type": "integer", "minimum": 1 },
        "caps": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^CAP-\\d{4}$" } },
        "protocol_min": { "type": "integer", "minimum": 1 },
        "protocol_max": { "type": ["integer", "null"] },
        "source": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["mainnet", "testnet", "local-core", "synthetic"] },
            "ledger": { "type": "integer" },
            "tx_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "core_version": { "type": "string" },
            "generator": { "type": "string" },
            "reproduce": { "type": "string", "description": "Exact command that regenerates this entry offline" },
            "core_capture": { "type": ["string", "null"], "description": "Path or URL of the LedgerCloseMeta this entry was cut from" },
            "lcm_golden_match": { "type": ["boolean", "null"], "description": "Agrees with stellar-core --check-lcm golden, where one exists" }
          }
        },
        "synthetic": { "type": "boolean" },
        "atoms": { "type": "array", "minItems": 1, "items": { "type": "string" },
                   "description": "Shape atoms covered; structural atoms use the generated atom IDs, value/relational atoms use val:/rel: prefixes" },
        "expected": { "type": "object", "minProperties": 1,
                      "description": "Path -> expected decoded value. Paths use the language-neutral SEP-style field names; values are JSON (64-bit+ integers as decimal strings)" },
        "sdk_rules": { "type": "array", "items": { "type": "string" },
                       "description": "Behavioural checks every SDK adapter must run against this entry" },
        "sightings": { "type": "array", "items": { "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+#\\d+$" } }
      }
    }
  }
}
